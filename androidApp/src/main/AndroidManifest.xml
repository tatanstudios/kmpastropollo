<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 13+: permiso para mostrar notificaciones (OneSignal lo pide al iniciar) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- screenOrientation="portrait" hace que Play exija pantalla vertical como hardware;
         se marca opcional para no excluir tablets, Chromebooks ni Android XR -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:name=".AstroApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logoastro"
        android:label="Astro Pollo"
        android:roundIcon="@mipmap/ic_logoastro_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AstroClienteCompose"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.onesignal.NotificationIcon"
            android:resource="@drawable/ic_stat_onesignal_default" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>

</manifest>
